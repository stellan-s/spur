# Local setup. Copy to .env.local; never commit real credentials.
# Uncomment only the optional sections you use. Keep all variables server-side.
DATABASE_URL=postgresql://spur:spur@localhost:5432/spur
# Local single-user mode: loopback only. Shared/cloud deployments need google or otp.
SPUR_AUTH=none
# Without an organisation, Spur runs the demo organisation on ./fixture-repo.
# For your own application, set all four. Repository evidence verification
# needs a configured source, even with code search off.
# SPUR_ORGANIZATION_SLUG=my-organisation
# SPUR_ORGANIZATION_NAME=My organisation
# SPUR_REPOSITORY_ROOT=../my-application
# SPUR_REPOSITORY_NAME=My application
# External MCP hosts answer with their own model; no provider key is needed.
SPUR_SYNTHESIS_PROVIDER=none

# Google sign-in (required when you change SPUR_AUTH above to google)
# SPUR_GOOGLE_CLIENT_ID=
# SPUR_GOOGLE_CLIENT_SECRET=
# Email-code sign-in alternative (required when SPUR_AUTH=otp).
# Choose smtp for any standards-compatible provider, or mailgun for its HTTP API.
# SPUR_EMAIL_PROVIDER=smtp
# SPUR_EMAIL_FROM=Spur <login@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Mailgun adapter alternative:
# SPUR_EMAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mail.example.com
# MAILGUN_BASE_URL=https://api.eu.mailgun.net
# SPUR_OTP_LIFETIME_SECONDS=600
# Optional comma-separated Workspace domains. Omission allows any verified Google
# account to request access. Approved organisation admins may use other domains.
# SPUR_ALLOWED_DOMAINS=example.com
# Exact emails eligible to create the first administrator, including personal Gmail.
# Remove after setup; existing approved administrators retain their access.
# SPUR_BOOTSTRAP_ADMINS=owner@example.com
# Listed, approved users become the first security owner while there is none.
# Remove after setup; existing security owners retain their role.
# SPUR_BOOTSTRAP_SECURITY_OWNERS=
# Canonical public origin for OAuth redirects, MCP resource ids and origin checks.
# SPUR_PUBLIC_URL=https://spur.example.com

# Answer generation inside Spur (optional; choose one provider)
# Change SPUR_SYNTHESIS_PROVIDER above to openai or anthropic and supply its key/model.
# Saved organisation model_provider overrides this environment default. If already
# saved, update it in the admin feature settings too. Credentials are validated
# before that override: don't remove a key while its provider is selected above.
# SPUR_MODEL_PROVIDER is a supported legacy alias; prefer SPUR_SYNTHESIS_PROVIDER.

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Optional: omitted means no explicit reasoning effort is sent.
# SPUR_OPENAI_REASONING_EFFORT=low

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Sources (optional overrides)
# SPUR_SOURCE_PROVIDER=local
# More local repositories, separated by ':' on macOS/Linux or ';' on Windows.
# SPUR_ADDITIONAL_REPOSITORIES=
# Live code search: off (default), ask or on. Saved code_search overrides this default.
# SPUR_CODE_SEARCH=off

# GitHub alternative (no local checkout needed)
# SPUR_SOURCE_PROVIDER=github
# SPUR_GITHUB_OWNER=
# SPUR_GITHUB_REPOSITORY=
# Read-only Contents permission. Use an App ID/private key pair, OR a short-lived
# installation token for local testing; the App pair mints fresh tokens as needed.
# SPUR_GITHUB_APP_ID=
# SPUR_GITHUB_APP_PRIVATE_KEY=
# SPUR_GITHUB_APP_TOKEN=
# SPUR_GITHUB_API_URL=https://api.github.com

# Naming and restricted information (optional)
# SPUR_ACTOR_NAME=Local operator
# Product name used in answers, and other names it is searched by.
# SPUR_APPLICATION_NAME=Northstar Commerce
# SPUR_APPLICATION_ALIASES=Northstar
# Contact shown instead of "the security owner" for restricted controls.
# SPUR_SECURITY_CONTACT=Security team
# Local mode masks restricted details by default. Use on only to opt in locally.
# SPUR_LOCAL_RESTRICTED_READ=off

# Runtime limits (optional; built-in defaults shown)
# SPUR_MODEL_TIMEOUT_MS=20000
# SPUR_MAX_OUTPUT_TOKENS=1200
# SPUR_SESSION_LIFETIME_SECONDS=604800
# Maximum remote MCP tool calls per approved user in one minute.
# SPUR_MCP_RATE_LIMIT_PER_MINUTE=60
# Authorisation callback hosts for MCP clients; loopback is always allowed.
# Remote MCP must also be enabled in the organisation's admin feature settings.
# SPUR_MCP_REDIRECT_HOSTS=claude.ai,claude.com

# Restart the web and MCP processes after changing their environment.
